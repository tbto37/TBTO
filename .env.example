# ==========================================
# TOBETHEONE Contact Form Email (SMTP) 설정
# ==========================================

# 문의 메일을 수신할 대표 이메일 주소
CONTACT_RECEIVER_EMAIL=tobetheone@tobetheone.kr

# 발신자 메일 정보 (SMTP 설정)
# 예시 1) Google Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-gmail-app-password (구글 2단계 인증용 앱 비밀번호 16자리)
# SMTP_FROM="TOBETHEONE 웹사이트" <your-email@gmail.com>

# 예시 2) 네이버 메일:
# SMTP_HOST=smtp.naver.com
# SMTP_PORT=465
# SMTP_USER=your-id@naver.com
# SMTP_PASS=your-naver-password
# SMTP_FROM="TOBETHEONE 웹사이트" <your-id@naver.com>

# 예시 3) 네이버 웍스 / WorksMobile (회사 도메인 메일):
# SMTP_HOST=smtp.worksmobile.com
# SMTP_PORT=465
# SMTP_USER=tobetheone@tobetheone.kr
# SMTP_PASS=your-password
# SMTP_FROM="TOBETHEONE 웹사이트" <tobetheone@tobetheone.kr>

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TOBETHEONE 웹사이트" <tobetheone@tobetheone.kr>
